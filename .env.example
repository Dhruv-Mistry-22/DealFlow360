# DealFlow360 Environment Variables Example

# Backend Settings
# Note: In development, we use SQLite database.
DATABASE_URL=sqlite:///./dealflow360.db
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Provider Keys
# Required for Deal Co-Pilot AI Risk Summary
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

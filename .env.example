# DealFlow360 Environment Variables Example

# Backend Settings
# Note: In development, we use SQLite or a local PostgreSQL instance.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dealflow360
SECRET_KEY=your_super_secret_jwt_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis Settings (for pub/sub feed)
REDIS_URL=redis://localhost:6379/0

# AI Provider Keys
# Required for Deal Co-Pilot Feed Narrations and Auto-drafts
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
